#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SDK="${FXCGSDK:-/opt/prizmsdk-linux}"

if [[ "$(id -u)" -eq 0 ]]; then
  exec runuser -u kali -- env PATH="$PATH" FXCGSDK="$SDK" "$0" "$@"
fi

if [[ ! -f "$SDK/toolchain/prizm_rules" ]]; then
  echo "ERROR: no se encuentra PrizmSDK en $SDK" >&2
  exit 1
fi

export FXCGSDK="$SDK"
make -C "$ROOT/apps/CasioWIFI" -j2
install -d -m 0775 "$ROOT/dist"
install -m 0664 "$ROOT/apps/CasioWIFI/CASIOWIFI.g3a" "$ROOT/dist/CASIOWIFI.g3a"

sha256sum "$ROOT/dist/CASIOWIFI.g3a"
