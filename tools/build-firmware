#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
FQBN="esp32:esp32:XIAO_ESP32C3"
BUILD="$ROOT/.build/esp32"
SKETCH="$ROOT/firmware/casioesp_wifi"

if [[ "$(id -u)" -eq 0 ]]; then
  exec runuser -u kali -- env PATH="$PATH" "$0" "$@"
fi

mkdir -p "$BUILD" "$ROOT/dist"
"$ROOT/tools/arduino-cli" compile --fqbn "$FQBN" --build-path "$BUILD" "$SKETCH"

install -m 0664 "$BUILD/casioesp_wifi.ino.bin" "$ROOT/dist/cg50-espmod-esp32-app.bin"
if [[ -f "$BUILD/casioesp_wifi.ino.merged.bin" ]]; then
  install -m 0664 "$BUILD/casioesp_wifi.ino.merged.bin" "$ROOT/dist/cg50-espmod-esp32-merged.bin"
fi

sha256sum "$ROOT/dist"/cg50-espmod-esp32-*.bin
