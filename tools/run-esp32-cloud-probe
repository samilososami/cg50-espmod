#!/usr/bin/env python3
"""Run the real Wi-Fi/TLS/Ollama streaming probe, then restore normal firmware.

The API key is read locally and sent only over the USB serial connection. Its
value is never printed. This utility intentionally requires an explicit key
file and always attempts to restore the production bridge in a finally block.
"""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import time


ROOT = Path(__file__).resolve().parents[1]
PORT = Path(sys.argv[1] if len(sys.argv) > 1 else "/dev/ttyACM0")
ARDUINO = ROOT / "tools/arduino-cli"
SKETCH = ROOT / "verification/esp32-cloud-probe"
BUILD = ROOT / ".build/esp32-cloud-probe"
KEY_FILE = Path(os.environ.get("CASIOGPT_API_FILE", ROOT / "casiogpt_api.txt"))
FQBN = "esp32:esp32:XIAO_ESP32C3"


def flash_probe() -> None:
    subprocess.run(
        [str(ARDUINO), "compile", "--fqbn", FQBN, "--build-path", str(BUILD), str(SKETCH)],
        check=True,
    )
    subprocess.run(
        [str(ARDUINO), "upload", "--fqbn", FQBN, "--input-dir", str(BUILD), "--port", str(PORT), str(SKETCH)],
        check=True,
    )


def restore_bridge() -> None:
    subprocess.run([str(ROOT / "tools/flash-esp32"), str(PORT)], check=True)


def run_probe(key: str) -> None:
    import serial

    with serial.Serial(str(PORT), 115200, timeout=0.2) as device:
        deadline = time.monotonic() + 25
        while time.monotonic() < deadline:
            line = device.readline().decode("utf-8", "replace").strip()
            if line:
                print(line)
            if line == "READY":
                break
        else:
            raise RuntimeError("La sonda no quedo lista")

        device.write(("KEY " + key.encode().hex() + "\n").encode())
        device.flush()
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            line = device.readline().decode("utf-8", "replace").strip()
            if line:
                print(line)
            if line == "KEY_OK":
                break
        else:
            raise RuntimeError("La sonda no acepto la clave")

        device.write(("PROMPT " + "Reply only with OK.".encode().hex() + "\n").encode())
        device.flush()
        deadline = time.monotonic() + 90
        success = False
        while time.monotonic() < deadline:
            line = device.readline().decode("utf-8", "replace").strip()
            if line:
                print(line)
            if line == "RESULT OK":
                success = True
            if line == "READY" and success:
                break
        if not success:
            raise RuntimeError("La peticion desde la ESP32 fallo")


def main() -> int:
    if os.geteuid() == 0:
        os.execvp(
            "runuser",
            ["runuser", "-u", "kali", "--", sys.executable, str(Path(__file__).resolve()), str(PORT)],
        )
    if not PORT.exists():
        raise RuntimeError(f"No existe {PORT}")
    if not KEY_FILE.is_file():
        raise RuntimeError("Falta casiogpt_api.txt o CASIOGPT_API_FILE")
    key = KEY_FILE.read_text(encoding="ascii").strip()
    if len(key) < 24:
        raise RuntimeError("La API key local no tiene un formato valido")

    try:
        flash_probe()
        run_probe(key)
        print("PASS ESP32 cloud probe: Wi-Fi, TLS, auth, model and streaming response.")
    finally:
        # Never leave the diagnostic sketch installed after the test.
        restore_bridge()
        key = ""
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
