#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT/dist"
mapfile -t files < <(find . -maxdepth 1 -type f ! -name checksums.txt -printf '%f\n' | LC_ALL=C sort)
if [[ "${#files[@]}" -eq 0 ]]; then
  echo "ERROR: dist/ no contiene artefactos" >&2
  exit 1
fi
sha256sum "${files[@]}" > checksums.txt
cat checksums.txt
